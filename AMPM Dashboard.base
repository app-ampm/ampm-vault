# Live tables over the vault's note properties (Obsidian Bases). Open this file, or embed a view in a note with
# ![[AMPM Dashboard.base#Open items]]. Each view is a tab; columns are note properties.
properties:
  note.affects_estimate:
    displayName: Affects estimate
  note.raised_on:
    displayName: Raised
  note.decided_on:
    displayName: Decided
  note.relates:
    displayName: Relates to
  note.questions:
    displayName: Questions
  note.started:
    displayName: Started
  note.requests:
    displayName: Requests
  note.commits:
    displayName: Commits
views:
  - type: table
    name: Open items
    filters:
      and:
        - 'type == "open-item"'
    order:
      - file.name
      - note.status
      - note.owner
      - note.affects_estimate
      - note.questions
      - note.raised_on
    sort:
      - property: note.status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Build decisions
    filters:
      and:
        - 'type == "build-decision"'
    order:
      - file.name
      - note.status
      - note.area
      - note.date
      - note.relates
      - note.session
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: Sessions
    filters:
      and:
        - 'type == "session"'
    order:
      - file.name
      - note.title
      - note.started
      - note.requests
      - note.commits
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: AMPM decisions
    filters:
      and:
        - 'type == "decision"'
    order:
      - file.name
      - note.status
      - note.tier
      - note.decided_on
    sort:
      - property: note.tier
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Assumptions
    filters:
      and:
        - 'type == "assumption"'
    order:
      - file.name
      - note.status
      - note.register
      - note.questions
    sort:
      - property: note.status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Assumptions not settled
    filters:
      and:
        - 'type == "assumption"'
        - or:
            - 'status == "open"'
            - 'status == "partly"'
    order:
      - file.name
      - note.status
      - note.register
      - note.questions
    sort:
      - property: note.register
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Findings
    filters:
      and:
        - 'type == "finding"'
    order:
      - file.name
      - note.kind
      - note.title
      - note.questions
    sort:
      - property: note.kind
        direction: ASC
      - property: file.name
        direction: ASC
