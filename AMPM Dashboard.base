properties:
  note.affects_estimate:
    displayName: Affects estimate
  note.raised_on:
    displayName: Raised
  note.decided_on:
    displayName: Decided
  note.relates:
    displayName: Relates to
  note.questions:
    displayName: Questions
  note.started:
    displayName: Started
  note.requests:
    displayName: Requests
  note.commits:
    displayName: Commits
views:
  - type: table
    name: Open items
    filters:
      and:
        - type == "open-item"
    order:
      - file.name
      - status
      - owner
      - affects_estimate
      - questions
      - raised_on
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Build decisions
    filters:
      and:
        - type == "build-decision"
    order:
      - file.name
      - status
      - area
      - date
      - relates
      - session
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: Sessions
    filters:
      and:
        - type == "session"
    order:
      - file.name
      - title
      - started
      - requests
      - commits
    sort:
      - property: date
        direction: DESC
  - type: table
    name: AMPM decisions
    filters:
      and:
        - type == "decision"
    order:
      - file.name
      - status
      - tier
      - decided_on
    sort:
      - property: tier
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Assumptions
    filters:
      and:
        - type == "assumption"
    order:
      - file.name
      - status
      - register
      - questions
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Assumptions not settled
    filters:
      and:
        - type == "assumption"
        - or:
            - status == "open"
            - status == "partly"
    order:
      - file.name
      - status
      - register
      - questions
    sort:
      - property: register
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Findings
    filters:
      and:
        - type == "finding"
    order:
      - file.name
      - kind
      - title
      - questions
    sort:
      - property: kind
        direction: ASC
      - property: file.name
        direction: ASC
